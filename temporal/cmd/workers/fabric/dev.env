TEMPORAL_ADDRESS=:7233
TEMPORAL_NAMESPACE=fabric-org1
TEMPORAL_TASK_QUEUE=infra
HEALTH_CHECK_ADDRESS=:8080
LOG_LEVEL=debug

# Operator configuration (owns shared TLS infrastructure)
OPERATOR_ID=metacensus

# Fabric organization configuration
ORG_ID=org1

# Vault configuration
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root
VAULT_MOUNT_PATH=secret
VAULT_ENGINE_TYPE=kv

# Kubernetes configuration
KUBECONFIG=/etc/kubernetes/kubeconfig

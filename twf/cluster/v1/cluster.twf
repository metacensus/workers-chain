# Cluster: renders and applies the Fabric charts for an owner stated in the
# input, with the credentials of whichever worker hosts it.
# pseudo-twf(leaf): proto and lib keep this space at cluster/fabric/v1. twf resolves an import by its
# leaf, so that path would resolve to the fabric package; this package is cluster, at cluster/v1.
package cluster

import "github.com/metacensus/library-temporal-kube/twf/helm/v1"
import "github.com/metacensus/library-temporal-kube/twf/kube/v1"
import "github.com/metacensus/workers-chain/twf/temporalmtls/v1"

workflow CreateNamespace(owner: Owner) -> (NamespaceName):
    activity helm.RenderChart("fabric/namespace", "fabric-namespace", owner.kubernetesNamespace, Values{owner}) -> resources
    activity kube.Apply(resources)
    close complete(owner.kubernetesNamespace)

workflow CreateServiceAccount(owner: Owner):
    activity helm.RenderChart("fabric/service-account", "fabric-service-account", owner.kubernetesNamespace, Values{owner}) -> resources
    activity kube.Apply(resources)
    close complete

# The component's name selects the chart, its values and its namespace.
workflow CreateDeployment(owner: Owner, component: Component) -> (DeploymentName):
    chart, values, namespace, name = componentRelease(owner, component, operator)
    # The worker chart mounts the Temporal mTLS client secret.
    if (component == "worker"):
        activity temporalmtls.EnsureTemporalMTLSClientCert(namespace, owner.temporalNamespace)
    activity helm.RenderChart(chart, chart.release, namespace, values) -> resources
    activity kube.Apply(resources)
    close complete(name)

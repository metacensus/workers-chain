# Certificate authority: identities and issuance, as the worker's owner.
# A signing issuer is always that owner's; a TLS issuer may be another's.
package certauth

import "github.com/metacensus/library-temporal-kube/twf/kube/v1"
import "github.com/metacensus/workers-chain/twf/secrets/v1"

# The one cross-owner operation. Only a public CSR crosses out and only public
# material crosses back.
nexus service CertificateAuthority:
	# pseudo-twf(wire-name): fabric.certauth.v1.CertificateAuthority on the wire;
	# a service name is one identifier, a dotted one a syntax error.
	async SignCertificate workflow SignCertificate

workflow SignCertificate(issuer: CertificateAuthorityRef, subject: Subject, csr: CsrPem, requester: Owner) -> (SignedCertificate):
	id_scheme: "fabric/sign-certificate/{subject.commonName}"
	default_options:
		workflow_id_reuse_policy: ALLOW_DUPLICATE_FAILED_ONLY
		workflow_id_conflict_policy: USE_EXISTING
	# The server has already bound requester to this endpoint's org; these checks are what the
	# handler can verify itself.
	if (not owns(owner, issuer)):
		close fail(ErrNotOwned)
	if (subject.profile == "ca" or privilegedAttributes(subject)):
		close fail(ErrPrivilegedRequest)
	# Only orgs obtain certificates here; the operator owns the chain.
	if (not requester.orgId):
		close fail(ErrInvalidInput)
	if (not inTrustDomain(subject, requester.orgId)):
		close fail(ErrSubjectOutOfScope)
	# A Nexus caller never chooses the registrar: the issuer signs as its own permanent admin.
	activity SignCsr(issuer, subject, csr, null) -> signed
	close complete(SignedCertificate{signed.certificate, signed.chain})

# pseudo-twf(plain-function): Go function in the caller's history and security context, never a
# workflow type (OWNERSHIP P3). It is a workflow here so that its Nexus edge is checked once.
# An activity cannot hold the edge: its body takes no calls.
workflow IssueCertificate(issuer: CertificateAuthorityRef, subject: Subject, storage: IdentityRef, registrar: IdentityRef):
	activity secrets.EnsureKeyPair(storage.keyRef)
	activity GenerateCsr(storage.keyRef, subject) -> csr
	activity secrets.CheckCertificate(storage.keyRef, storage.certRef, subject) -> current
	if (current):
		close complete
	if (owns(owner, issuer)):
		activity SignCsr(issuer, subject, csr, registrar) -> signed
	else:
		# Only orgs reach a foreign issuer: the operator owns the shared chain.
		if (owner.isOperator):
			close fail(ErrSignCertificate)
		nexus fabric-shard-{org}-CreateCertificate CertificateAuthority.SignCertificate(issuer, subject, csr, owner) -> signed
			options:
				schedule_to_close_timeout: 5m
	activity secrets.StoreCertificate(storage.certRef, signed.certificate, signed.chain)
	close complete

# pseudo-twf(plain-function): Go function in the caller's history and security context, never a
# workflow type (OWNERSHIP P3). Register-less: no registrar exists yet, and no Nexus branch.
workflow BootstrapIssueCertificate(ca: CaUrl, credentials: SecretRef, subject: Subject, storage: IdentityRef):
	activity secrets.EnsureKeyPair(storage.keyRef)
	activity GenerateCsr(storage.keyRef, subject) -> csr
	activity secrets.CheckCertificate(storage.keyRef, storage.certRef, subject) -> current
	if (current):
		close complete
	activity BootstrapEnrollCsr(ca, credentials, csr) -> signed
	activity secrets.StoreCertificate(storage.certRef, signed.certificate, signed.chain)
	close complete

workflow CreateBootstrapAdmin(ca: CertificateAuthorityRef, tlsIssuer: CertificateAuthorityRef) -> (AdminIdentity):
	if (not owns(owner, ca)):
		close fail(ErrNotOwned)
	# Ready fails until the CA is up; the retry policy is the wait.
	activity kube.Ready(ca.resource)
		options:
			start_to_close_timeout: 10m
			retry_policy:
				initial_interval: 5s
				backoff_coefficient: 1.0
				maximum_attempts: 0
	workflow BootstrapIssueCertificate(ca.url, ca.bootstrapCredentials, bootstrapSubject(ca), ca.bootstrapSigning)
	tlsIssuer = tlsIssuer or ca
	if (owns(owner, tlsIssuer)):
		workflow BootstrapIssueCertificate(tlsIssuer.url, tlsIssuer.bootstrapCredentials, bootstrapSubject(tlsIssuer), ca.bootstrapTls)
	else:
		workflow IssueCertificate(tlsIssuer, tlsSubject(ca.bootstrapAdmin), ca.bootstrapTls, null)
	close complete(AdminIdentity{ca.bootstrapSigning, ca.bootstrapTls})

workflow CreateAdmin(ca: CertificateAuthorityRef, signingIssuer: CertificateAuthorityRef, tlsIssuer: CertificateAuthorityRef) -> (AdminIdentity):
	if (not owns(owner, ca) or not owns(owner, signingIssuer or ca)):
		close fail(ErrNotOwned)
	# A CA's own bootstrap admin registers its permanent admin; another CA's permanent admin
	# otherwise. A foreign TLS issuer ignores the registrar and signs as its own admin.
	workflow IssueCertificate(signingIssuer or ca, adminSubject(ca), ca.adminSigning, registrarOf(signingIssuer or ca))
	workflow IssueCertificate(tlsIssuer or ca, tlsSubject(ca.admin), ca.adminTls, registrarOf(tlsIssuer or ca))
	close complete(AdminIdentity{ca.adminSigning, ca.adminTls})

workflow CreateIdentity(subject: Subject, orgIssuer: CertificateAuthorityRef, tlsIssuer: CertificateAuthorityRef, signingStorage: IdentityRef, tlsStorage: IdentityRef) -> (Identity):
	id_scheme: "fabric/create-identity/{subject.commonName}"
	default_options:
		workflow_id_reuse_policy: ALLOW_DUPLICATE_FAILED_ONLY
		workflow_id_conflict_policy: USE_EXISTING
	if (not owns(owner, orgIssuer)):
		close fail(ErrNotOwned)
	workflow IssueCertificate(orgIssuer, subject, signingStorage, null)
	# The TLS issuer may be foreign; IssueCertificate decides.
	workflow IssueCertificate(tlsIssuer, subject, tlsStorage, null)
	close complete(Identity{signingStorage, tlsStorage})

activity RevokeIdentity(ca: CertificateAuthorityRef, identity: IdentityName, reason: Reason, registrar: IdentityRef) -> (Revoked):
	return fabricCa.revoke(ca, identity, reason, registrar)

# The key is read from the owner's subtree; only the public CSR comes back.
activity GenerateCsr(keyRef: SecretRef, subject: Subject) -> (CsrPem):
	return x509.csr(vault.read(keyRef), subject)

activity BootstrapEnrollCsr(ca: CaUrl, credentials: SecretRef, csr: CsrPem) -> (SignedCertificate):
	return fabricCa.enroll(ca, vault.read(credentials), csr)

activity SignCsr(ca: CertificateAuthorityRef, subject: Subject, csr: CsrPem, registrar: IdentityRef) -> (SignedCertificate):
	return fabricCa.registerAndEnroll(ca, registrar or ca.permanentAdmin, subject, csr)

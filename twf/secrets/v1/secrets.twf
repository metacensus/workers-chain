# Secrets: Vault-backed material and access, as the hosting worker's own token.
package secrets

import "github.com/metacensus/workers-chain/twf/vault/v1"

# The infra worker's view of Vault, offered across owners: fabric and shard
# workers ask for access for their own components.
nexus service Secrets:
	# pseudo-twf(wire-name): secrets.v1.Secrets on the wire;
	# a service name is one identifier, a dotted one a syntax error.
	async CreateAccess workflow CreateAccess

workflow CreateAccess(access: VaultAccess) -> (VaultAccessNames):
	id_scheme: "secrets/create-access/{access.policyName}"
	# Handlers cannot identify the caller, so policy paths are scoped to the namespace being bound.
	if (not ownerNamespace(access.kubernetesNamespace) or not withinSubtree(access.policy, access.kubernetesNamespace)):
		close fail(ErrPolicyOutOfScope)
	activity vault.CreatePolicy(access.policyName, access.policy) -> policy
	activity vault.CreateAuthRole(access.authRoleName, access.serviceAccountName, access.kubernetesNamespace, policy.name) -> role
	close complete(VaultAccessNames{policy.name, role.name})

activity EnsurePassword(ref: SecretRef, username: Username) -> (SecretRef):
	return vault.getOrCreatePassword(ref, username)

# Get-or-create, so re-runs reuse the key. The key stays in the owner's subtree.
activity EnsureKeyPair(ref: SecretRef) -> (SecretRef):
	return vault.getOrCreateKeyPair(ref)

activity CreateSelfSignedCertificate(keyRef: SecretRef, certRef: SecretRef, subject: Subject) -> (SecretRef):
	return vault.storeSelfSigned(keyRef, certRef, subject)

activity StoreCertificate(certRef: SecretRef, certificate: CertificatePem, chain: ChainPem) -> (SecretRef):
	return vault.store(certRef, certificate, chain)

activity StoreGenesisBlock(block: GenesisBlock):
	# Not implemented yet.
	fail(ErrStoreGenesisBlock)
